{
  "name": "pi-notifi",
  "version": "1.9.0",
  "description": "Pi extension that sends focus-aware desktop notifications when pi finishes a task.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "notifications",
    "notification",
    "notify",
    "notice",
    "warning",
    "ping",
    "notify-send",
    "hyprland",
    "tmux",
    "ghostty",
    "dunst"
  ],
  "type": "module",
  "files": [
    "index.ts",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit && bash -n scripts/notifi-focus && npm test"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "jiti": "^2.7.0",
    "typescript": "latest"
  }
}
