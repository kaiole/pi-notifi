#!/usr/bin/env bash
set -euo pipefail

target_id="${1:-}"
targets_dir="${XDG_CACHE_HOME:-$HOME/.cache}/notifi/targets"

prune_targets() {
  [[ -d "$targets_dir" ]] || return 0
  find "$targets_dir" -maxdepth 1 -type f -name '*.json' -mmin +1440 -delete 2>/dev/null || true
}

if [[ -z "$target_id" ]]; then
  prune_targets
  exit 0
fi

# notifi currently generates UUIDs. Reject anything path-like so this helper
# cannot be used to read/delete files outside the target cache directory.
if [[ ! "$target_id" =~ ^[0-9a-fA-F-]{36}$ ]]; then
  prune_targets
  exit 0
fi

state_file="$targets_dir/${target_id}.json"

if [[ ! -f "$state_file" ]]; then
  prune_targets
  exit 0
fi

consume_bad_target() {
  rm -f -- "$state_file"
  prune_targets
  exit 0
}

workspace_id="$(jq -r '.workspaceId // empty' "$state_file" 2>/dev/null)" || consume_bad_target
hypr_window_address="$(jq -r '.hyprWindowAddress // empty' "$state_file" 2>/dev/null)" || consume_bad_target
tmux_socket_path="$(jq -r '.tmuxSocketPath // empty' "$state_file" 2>/dev/null)" || consume_bad_target
tmux_server_pid="$(jq -r '.tmuxServerPid // empty' "$state_file" 2>/dev/null)" || consume_bad_target
tmux_session_id="$(jq -r '.tmuxSessionId // empty' "$state_file" 2>/dev/null)" || consume_bad_target
tmux_window_id="$(jq -r '.tmuxWindowId // empty' "$state_file" 2>/dev/null)" || consume_bad_target
tmux_pane_id="$(jq -r '.tmuxPaneId // empty' "$state_file" 2>/dev/null)" || consume_bad_target
tmux_client_tty="$(jq -r '.tmuxClientTty // empty' "$state_file" 2>/dev/null)" || consume_bad_target

rm -f -- "$state_file"
prune_targets

# Old/unscoped targets cannot safely identify a server. Never guess or use the
# helper's inherited TMUX environment. Also reject a replacement server at the
# same socket, whose session/window/pane IDs may have been reused.
if [[ "$tmux_socket_path" != /* || ! "$tmux_server_pid" =~ ^[1-9][0-9]*$ || -z "$tmux_session_id" || -z "$tmux_window_id" ]]; then
  exit 0
fi

tmux_cmd=(tmux -N -S "$tmux_socket_path")
live_server_pid="$("${tmux_cmd[@]}" display-message -p '#{pid}' 2>/dev/null)" || exit 0
[[ "$live_server_pid" == "$tmux_server_pid" ]] || exit 0

if ! "${tmux_cmd[@]}" has-session -t "$tmux_session_id" 2>/dev/null; then
  exit 0
fi

if ! "${tmux_cmd[@]}" list-windows -t "$tmux_session_id" -F '#{window_id}' | grep -Fxq "$tmux_window_id"; then
  exit 0
fi

hypr_window_exists() {
  [[ -n "$hypr_window_address" ]] && \
    hyprctl clients -j | jq -e --arg address "$hypr_window_address" '.[] | select(.address == $address)' >/dev/null
}

tmux_pane_exists() {
  [[ -n "$tmux_pane_id" ]] || return 1
  "${tmux_cmd[@]}" list-panes -a -F '#{pane_id}' 2>/dev/null | grep -Fxq "$tmux_pane_id"
}

saved_tmux_target() {
  if tmux_pane_exists; then
    printf '%s\n' "$tmux_pane_id"
  else
    printf '%s:%s\n' "$tmux_session_id" "$tmux_window_id"
  fi
}

select_saved_pane() {
  tmux_pane_exists || return 0
  "${tmux_cmd[@]}" select-pane -t "$tmux_pane_id" 2>/dev/null || true
}

select_saved_window() {
  "${tmux_cmd[@]}" select-window -t "$tmux_session_id:$tmux_window_id" 2>/dev/null || true
  select_saved_pane
}

switch_client_to_saved_target() {
  local target
  target="$(saved_tmux_target)"

  if [[ -n "$tmux_client_tty" ]]; then
    "${tmux_cmd[@]}" switch-client -c "$tmux_client_tty" -t "$target" 2>/dev/null || select_saved_window
  else
    select_saved_window
  fi
}

focus_hypr_workspace() {
  [[ "$workspace_id" =~ ^-?[0-9]+$ ]] || return 1

  # Hyprland 0.55 replaced the old dispatcher CLI syntax with Lua.
  hyprctl dispatch "hl.dsp.focus({ workspace = $workspace_id })" >/dev/null 2>&1 ||
    hyprctl dispatch workspace "$workspace_id" >/dev/null 2>&1
}

focus_hypr_window() {
  [[ "$hypr_window_address" =~ ^0x[0-9a-fA-F]+$ ]] || return 1

  hyprctl dispatch "hl.dsp.focus({ window = 'address:$hypr_window_address' })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$hypr_window_address" >/dev/null 2>&1
}

if [[ -n "$workspace_id" ]]; then
  focus_hypr_workspace || true
fi

if hypr_window_exists; then
  focus_hypr_window || true
  switch_client_to_saved_target
else
  select_saved_window
  ghostty -e "${tmux_cmd[@]}" attach-session -t "$tmux_session_id" >/dev/null 2>&1 &
fi
